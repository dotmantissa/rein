# @privy-io/react-auth declares peerOptional @farcaster/mini-app-solana@^1.0.0
# while this project pins ^2.0.0. The Farcaster/Solana code paths are unused
# here, so the mismatch is inert — but npm's strict peer resolution fails the
# install. Match the resolution the committed lockfile was built with.
legacy-peer-deps=true
